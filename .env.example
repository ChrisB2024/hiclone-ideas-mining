# Copy to .env and fill in. .env is gitignored and must never be committed.
# config.py is the ONLY module that reads the environment.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ideas_mining
REDIS_URL=redis://localhost:6379

# Reddit — read-only script app, no user credentials needed
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ideas-mining/0.1

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# EMBEDDING_DIM must equal the model's real output dimension AND the vector(N) baked
# into migration 0001. Changing it invalidates every stored embedding, so a change here
# means a new migration plus a re-embed — not an edit. models.py refuses to load on a
# non-positive value.
EMBED_MODEL=voyage-3.5
EMBEDDING_DIM=1024

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
DIGEST_TO_ADDRESS=
# Optional; falls back to SMTP_USER. Most providers reject a From they don't own.
DIGEST_FROM_ADDRESS=

LOG_LEVEL=INFO
