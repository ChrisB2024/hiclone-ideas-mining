# Copy to .env and fill in. .env is gitignored and must never be committed.
# config.py is the ONLY module that reads the environment.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ideas_mining
REDIS_URL=redis://localhost:6379

# Reddit — read-only script app, no user credentials needed
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ideas-mining/0.1

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# OQ-1 [BLOCKER]: pick the Voyage model, then set EMBEDDING_DIM to its real dimension.
# vector(N) in the schema must match. Changing N later invalidates every stored
# embedding. models.py refuses to load while EMBEDDING_DIM is 0.
EMBED_MODEL=
EMBEDDING_DIM=0

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_TO_ADDRESS=
